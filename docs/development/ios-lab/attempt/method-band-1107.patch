+/* ================= iOS: the band behind the Dynamic Island and under Safari's bar (owner, 7 Nov) =================
+   Safari draws behind its island and under its bottom bar only what scrolls with the page: the held stage (sticky) is cut at the
+   island's foot and at the bar, and there it paints html's colour (iPhone, lab2–lab3, 7 Nov). The whole stage held in flow by a
+   scroll-driven animation reached both strips (lab4), but under a quick finger Safari left it a frame behind now and then: the whole
+   scene 5–20 px off for one frame and back, on a page with no work too (owner's iPhone, lab6, 7 Nov). So the stage stays sticky —
+   still — and only a copy of its ground is held in flow beneath it (.m-band, made by method-stage.ts, iOS only): the night, the light
+   with the room, its spill, the dark of 11, every animation started on the copy in the same frame as on the original. The copy is seen
+   only where Safari cuts the stage, so a frame behind there is a strip of wall or sky, not the scene. Masked to those two strips (and
+   40 px inside the screen, under the stage) so it never shows through the stage's open parts. It is where the stage is: at the
+   section's top (the stage's −70 px margin collapses into the section's own), held from the section's top 70 px above the screen's
+   (the sticky's moment, top −70) one pixel per pixel of scroll until the stage lets go (7.7 − 1 screens less the lift), in px: the
+   range's length changes with the bars, the band must not (Simulator, 7 Nov: band and stage at the same pixel before, during, after). Hidden while the site jumps (src/lib/leap.ts): the animation lags a jump
+   ~10 frames (Xiaomi, 7 Nov), and the strips show html's colour meanwhile. */
+.m-band {
+  display: none;
+}
+@media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
+  @supports (-webkit-touch-callout: none) and (animation-timeline: view()) {
+    :root[data-js] .method {
+      view-timeline: --m-hold block;
+    }
+    :root[data-js] .method .m-band {
+      display: block;
+      position: absolute;
+      z-index: -1;
+      left: 0;
+      right: 0;
+      top: 0;
+      height: calc(var(--screen) + var(--m-lift, 0px));
+      overflow: hidden;
+      pointer-events: none;
+      animation: m-hold linear both;
+      animation-timeline: --m-hold;
+      animation-range: contain var(--m-lift, 0px) contain calc(0% + var(--screen) * 6.7);
+      -webkit-mask: linear-gradient(#000 0 calc(var(--m-lift, 0px) + 40px), transparent 0 calc(var(--m-lift, 0px) + 100svh - 40px), #000 0);
+      mask: linear-gradient(#000 0 calc(var(--m-lift, 0px) + 40px), transparent 0 calc(var(--m-lift, 0px) + 100svh - 40px), #000 0);
+    }
+    :root[data-js] .method .m-band * {
+      pointer-events: none !important;
+    }
+    :root[data-leap] .method .m-band {
+      visibility: hidden;
+    }
+  }
+}
+@keyframes m-hold {
+  from {
+    transform: translateY(0);
+  }
+  to {
+    transform: translateY(calc(var(--screen) * 6.7 - var(--m-lift, 0px)));
+  }
+}
