diff --git a/src/components/method/method.css b/src/components/method/method.css
index cef7eb8..4232a9e 100644
--- a/src/components/method/method.css
+++ b/src/components/method/method.css
@@ -1146,3 +1146,50 @@
     }
   }
 }
+
+/* ================= a phone: the held stage is content of the page, held still by the scroll itself (owner, 7 Nov) =================
+   Safari draws behind its Dynamic Island and under its bottom bar only what scrolls with the page: a sticky or fixed layer is cut at the
+   island's foot and the strip takes html's colour (iPhone, lab3, 7 Nov: magenta in all three, the scene in flow behind the island). So
+   on a phone the stage stays in flow and a scroll-driven animation moves it down exactly as far as the page goes up — run by the
+   compositor, no script: on the iPhone the stage stood within 0–1 px through a slow scroll, 4 px once as Safari's bar changed (lab4,
+   frame by frame at 60 fps; moved by script instead it shook 12–44 px). The same on Android, one way for both.
+   The hold starts when the section's top reaches the screen's (the sticky's moment) and runs one pixel per pixel of scroll for the
+   section's height less the screen (7.7 − 1 screens), in px, not as a share of the range: the range's length changes with the
+   browser's bars, the stage must not. Where scroll-driven animations do not exist the stage stays sticky (above). */
+@media (prefers-reduced-motion: no-preference) and (max-width: 899px) {
+  @supports (animation-timeline: view()) {
+    :root[data-js] .method {
+      view-timeline: --m-hold block;
+    }
+    /* the iOS lift (above) by a relative offset, not a negative margin: the stage is the section's first child in flow, and its margin
+       collapsed into the section's own (−3.1 screens) and was lost — the stage sat 70 px low, a dark band under the island and
+       everything 70 px down (iPhone tape, 7 Nov: the stage's top 0 while held, not −70). As sticky, its top had hidden it. */
+    :root[data-js] .method .m-stage {
+      position: relative;
+      top: calc(-1 * var(--m-lift, 0px));
+      margin-top: 0;
+      animation: m-hold linear both;
+      animation-timeline: --m-hold;
+      animation-range: contain 0% contain calc(0% + var(--screen) * 6.7);
+    }
+    /* a jump made by the site (src/lib/leap.ts): held by the browser, sticky as before, until it has landed */
+    :root[data-leap] .method .m-stage {
+      position: sticky;
+      top: calc(-1 * var(--m-lift, 0px));
+      animation: none;
+    }
+    /* letting go, back above the scene (method-stage.ts holdWhileLeaving): fixed where it is, as before */
+    :root[data-js] .method.m-leaving .m-stage {
+      position: fixed;
+      animation: none;
+    }
+  }
+}
+@keyframes m-hold {
+  from {
+    transform: translateY(0);
+  }
+  to {
+    transform: translateY(calc(var(--screen) * 6.7));
+  }
+}
